# Copy to .env and fill in. Never commit .env
# Generate: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
# Comma-separated host names (required unless DJANGO_DEBUG=1)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# 1 = development only (DEBUG on, relaxed hosts, no HTTPS enforcement)
DJANGO_DEBUG=0
# HTTPS enforcement (redirect, HSTS, secure cookies). Defaults to ON when DEBUG is off;
# set 0 only to run the production image over plain http on localhost.
DJANGO_HTTPS_ONLY=
# 1 if a TLS-terminating proxy sets X-Forwarded-Proto
DJANGO_TRUST_PROXY_SSL=0
HOST_PORT=8000
